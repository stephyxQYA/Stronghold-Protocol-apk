# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/

# --- game assets: (c) Hypergryph / Yostar, fetched or extracted locally, NEVER committed ----------
# tools/fetch-assets.mjs → public/assets/** and public/fonts/**
public/assets/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest.
# This fork keeps data/local-assets.json COMMITTED (the APK embeds it, so it ships with the local art);
# the line below only keeps a freshly generated copy out of a new checkout.
data/local-assets.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# NOTE: upstream ignores packs/index.json (it regenerates it with `node tools/packs.mjs index`).
# This fork COMMITS it instead: the Android bundle ships packs/ verbatim and the server answers
# /packs/index.json from it, so the file has to exist in a clean checkout.

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*

# --- Android (native shell) build output — regenerated by `node scripts/build-android.mjs` ---------
android/.gradle/
android/.idea/
android/local.properties
android/app/build/
android/app/src/main/assets/app_bundle.zip
android/app/src/main/assets/bundle.sha256
android/keystore/
*.jks
*.keystore

# --- built APKs ---
*.apk

# --- upstream release source fetched for a version sync (temporary working tree) ---
.upstream/

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.iml
.idea/
.vscode/
.claude/
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/
